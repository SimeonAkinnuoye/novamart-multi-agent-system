{
  "name": "novamart",
  "version": "1.0.0",
  "runtimes": [
    {
      "name": "udacity-agentcore-runtime",
      "build": "CodeZip",
      "entrypoint": "agent_orchestrator.py",
      "codeLocation": "build/runtime/",
      "runtimeVersion": "PYTHON_3_12",
      "instrumentation": {
        "enableOtel": false
      },
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "executionRoleArn": "arn:aws:iam::619621087001:role/udacity-agentcore-agentcore-role",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "PROJECT_NAME",
          "value": "udacity-agentcore"
        },
        {
          "name": "RETURNS_KB_ID",
          "value": "VLVO7Z0NAC"
        },
        {
          "name": "SHIPPING_KB_ID",
          "value": "YKNZHCZH33"
        },
        {
          "name": "WARRANTY_KB_ID",
          "value": "TCVXIKSNKG"
        },
        {
          "name": "AGENT_LOG_GROUP",
          "value": "/aws/bedrock/agentcore/udacity-agentcore"
        },
        {
          "name": "GUARDRAIL_ID",
          "value": "x3jdifsxg3z3"
        },
        {
          "name": "GUARDRAIL_VERSION",
          "value": "1"
        },
        {
          "name": "AGENT_LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "AGENT_LOG_TO_CLOUDWATCH",
          "value": "true"
        },
        {
          "name": "AGENT_TRACING_ENABLED",
          "value": "true"
        },
        {
          "name": "AGENT_TRACE_SAMPLING_RATE",
          "value": "1.0"
        }
      ]
    }
  ]
}
